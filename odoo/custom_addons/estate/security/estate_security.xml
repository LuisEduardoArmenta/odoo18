
<odoo>
    <data>
        <!-- 1. Definición de la Categoría de Aplicación para agrupar los permisos -->
        <record id="module_category_estate" model="ir.module.category">
            <field name="name">Real Estate</field>
            <field name="description">Users access levels for the Estate module</field>
            <field name="sequence">10</field>
        </record>

        <!-- 2. Definición de Grupos de Seguridad -->
        <record id="group_estate_user" model="res.groups">
            <field name="name">Agent</field>
            <field name="category_id" ref="module_category_estate"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_estate_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_estate_user'))]"/>
        </record>

        <!-- 3. Definición de Reglas de Registro (Record Rules) -->
        <!-- Regla para el Agente: solo ve sus propiedades -->
        <record id="property_rule_user_see_own" model="ir.rule">
            <field name="name">Estate Property: User can only see their own properties</field>
            <field name="model_id" ref="model_estate_property"/>
            <field name="groups" eval="[(4, ref('group_estate_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
        </record>

        <!-- Regla para el Gerente: ve todas las propiedades -->
        <record id="property_rule_manager_see_all" model="ir.rule">
            <field name="name">Estate Property: Manager can see all properties</field>
            <field name="model_id" ref="model_estate_property"/>
            <field name="groups" eval="[(4, ref('group_estate_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
