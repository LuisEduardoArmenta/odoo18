<odoo>
    <!-- Vista list para Property Tag -->
    <record id="view_estate_property_tag_list" model="ir.ui.view">
        <field name="name">estate.property.tag.list</field>
        <field name="model">estate.property.tag</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="property_count"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Vista form para Property Tag -->
    <record id="view_estate_property_tag_form" model="ir.ui.view">
        <field name="name">estate.property.tag.form</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <form string="Property Tag">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tag name..." class="o_text_overflow"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group string="Statistics">
                            <field name="property_count"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Describe what this tag represents..." nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda -->
    <record id="view_estate_property_tag_search" model="ir.ui.view">
        <field name="name">estate.property.tag.search</field>
        <field name="model">estate.property.tag</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Search Property Tags">
                <field name="name"/>
                <field name="description"/>
                <group expand="0" string="Group By">
                    <filter string="Color" name="group_by_color" context="{'group_by': 'color'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para Property Tag -->
    <record id="action_estate_property_tag" model="ir.actions.act_window">
        <field name="name">Property Tags</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú para Property Tag -->
    <menuitem id="menu_estate_property_tag" name="Property Tags" 
            parent="menu_estate_root" action="action_estate_property_tag" sequence="30"/>
</odoo> 