<odoo>
    <!-- Acción para Estate Offer -->
    <record id="action_estate_offer" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">estate.offer</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_property': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property offer!
            </p>
            <p>
                Manage offers from potential buyers for your properties.
            </p>
        </field>
    </record>

    <!-- Vista list para Estate Offer -->
    <record id="view_estate_offer_list" model="ir.ui.view">
        <field name="name">estate.offer.list</field>
        <field name="model">estate.offer</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'accepted'" 
                  decoration-danger="status == 'refused'"
                  decoration-info="not status">
                <field name="price" widget="monetary"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="property_type_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="status"/>
                <button name="action_accept" string="Accept" type="object" 
                        class="btn-success" invisible="status"/>
                <button name="action_refuse" string="Refuse" type="object" 
                        class="btn-danger" invisible="status"/>
            </list>
        </field>
    </record>

    <!-- Vista form para Estate Offer -->
    <record id="view_estate_offer_form" model="ir.ui.view">
        <field name="name">estate.offer.form</field>
        <field name="model">estate.offer</field>
        <field name="arch" type="xml">
            <form string="Property Offer">
                <header>
                    <button name="action_accept" string="Accept Offer" type="object" 
                            class="oe_highlight btn-success" 
                            invisible="status" 
                            confirm="Are you sure you want to accept this offer?"/>
                    <button name="action_refuse" string="Refuse Offer" type="object" 
                            class="btn-danger" 
                            invisible="status"
                            confirm="Are you sure you want to refuse this offer?"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>Offer: </span>
                            <field name="price" class="oe_inline" widget="monetary"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Offer Details">
                            <field name="partner_id"/>
                            <field name="property_id"/>
                            <field name="property_type_id"/>
                        </group>
                        <group string="Validity">
                            <field name="validity"/>
                            <field name="date_deadline"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda para Estate Offer -->
    <record id="view_estate_offer_search" model="ir.ui.view">
        <field name="name">estate.offer.search</field>
        <field name="model">estate.offer</field>
        <field name="arch" type="xml">
            <search string="Search Offers">
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="property_type_id"/>
                <field name="price"/>
                
                <filter string="Pending" name="pending" domain="[('status', '=', False)]"/>
                <filter string="Accepted" name="accepted" domain="[('status', '=', 'accepted')]"/>
                <filter string="Refused" name="refused" domain="[('status', '=', 'refused')]"/>
                
                <separator/>
                <filter string="High Value" name="high_value" domain="[('price', '>=', 200000)]"/>
                <filter string="Recent" name="recent" domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Property" name="group_by_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Partner" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Property Type" name="group_by_type" context="{'group_by': 'property_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Menú para Estate Offer -->
    <menuitem id="menu_estate_offer" name="Property Offers" 
              parent="menu_estate_root" action="action_estate_offer" sequence="15"/>
</odoo>
