<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Property Types Demo Data -->
        <record id="property_type_house" model="estate.property.type">
            <field name="name">House</field>
            <field name="sequence">1</field>
        </record>
        
        <record id="property_type_apartment" model="estate.property.type">
            <field name="name">Apartment</field>
            <field name="sequence">2</field>
        </record>
        
        <record id="property_type_studio" model="estate.property.type">
            <field name="name">Studio</field>
            <field name="sequence">3</field>
        </record>
        
        <record id="property_type_villa" model="estate.property.type">
            <field name="name">Villa</field>
            <field name="sequence">4</field>
        </record>
        
        <!-- Property Tags Demo Data -->
        <record id="property_tag_cozy" model="estate.property.tag">
            <field name="name">Cozy</field>
            <field name="color">2</field>
            <field name="description">Small and comfortable properties</field>
        </record>
        
        <record id="property_tag_renovated" model="estate.property.tag">
            <field name="name">Renovated</field>
            <field name="color">3</field>
            <field name="description">Recently renovated properties</field>
        </record>
        
        <record id="property_tag_luxury" model="estate.property.tag">
            <field name="name">Luxury</field>
            <field name="color">6</field>
            <field name="description">High-end luxury properties</field>
        </record>
        
        <record id="property_tag_garden" model="estate.property.tag">
            <field name="name">Garden</field>
            <field name="color">5</field>
            <field name="description">Properties with beautiful gardens</field>
        </record>
        
        <record id="property_tag_modern" model="estate.property.tag">
            <field name="name">Modern</field>
            <field name="color">1</field>
            <field name="description">Contemporary and modern properties</field>
        </record>
        
        <!-- Properties Demo Data -->
        <record id="property_1" model="estate.property">
            <field name="name">Beautiful Family House</field>
            <field name="description">A beautiful family house with a large garden and modern amenities. Perfect for families with children. Close to schools and shopping centers.</field>
            <field name="postcode">12345</field>
            <field name="date_availability">2025-09-21</field>
            <field name="expected_price">350000</field>
            <field name="bedrooms">4</field>
            <field name="living_area">150</field>
            <field name="facades">2</field>
            <field name="garage">True</field>
            <field name="garden">True</field>
            <field name="garden_area">200</field>
            <field name="garden_orientation">south</field>
            <field name="property_type_id" ref="property_type_house"/>
            <field name="tag_ids" eval="[(6, 0, [ref('property_tag_garden'), ref('property_tag_modern')])]"/>
        </record>
        
        <record id="property_2" model="estate.property">
            <field name="name">Cozy Studio Downtown</field>
            <field name="description">Perfect starter home or investment property. Located in the heart of the city with easy access to public transportation.</field>
            <field name="postcode">54321</field>
            <field name="date_availability">2025-09-06</field>
            <field name="expected_price">125000</field>
            <field name="bedrooms">1</field>
            <field name="living_area">45</field>
            <field name="facades">1</field>
            <field name="garage">False</field>
            <field name="garden">False</field>
            <field name="property_type_id" ref="property_type_studio"/>
            <field name="tag_ids" eval="[(6, 0, [ref('property_tag_cozy'), ref('property_tag_renovated')])]"/>
        </record>
        
        <record id="property_3" model="estate.property">
            <field name="name">Luxury Villa with Pool</field>
            <field name="description">Stunning luxury villa with swimming pool, tennis court, and panoramic views. This property offers the ultimate in luxury living.</field>
            <field name="postcode">98765</field>
            <field name="date_availability">2025-10-21</field>
            <field name="expected_price">1250000</field>
            <field name="bedrooms">6</field>
            <field name="living_area">400</field>
            <field name="facades">4</field>
            <field name="garage">True</field>
            <field name="garden">True</field>
            <field name="garden_area">1500</field>
            <field name="garden_orientation">south</field>
            <field name="property_type_id" ref="property_type_villa"/>
            <field name="tag_ids" eval="[(6, 0, [ref('property_tag_luxury'), ref('property_tag_garden'), ref('property_tag_modern')])]"/>
        </record>

    <!-- Datos demo para Partners (compradores) -->
    <record id="partner_john_doe" model="res.partner">
        <field name="name">John Doe</field>
        <field name="email">john.doe@example.com</field>
        <field name="phone">+1234567890</field>
    </record>

    <record id="partner_jane_smith" model="res.partner">
        <field name="name">Jane Smith</field>
        <field name="email">jane.smith@example.com</field>
        <field name="phone">+1234567891</field>
    </record>

    <record id="partner_bob_wilson" model="res.partner">
        <field name="name">Bob Wilson</field>
        <field name="email">bob.wilson@example.com</field>
        <field name="phone">+1234567892</field>
    </record>

    <!-- Datos demo para Estate Offer -->
    <record id="estate_offer_1" model="estate.offer">
        <field name="price">245000</field>
        <field name="partner_id" ref="partner_john_doe"/>
        <field name="property_id" ref="property_1"/>
        <field name="validity">7</field>
    </record>

    <record id="estate_offer_2" model="estate.offer">
        <field name="price">250000</field>
        <field name="partner_id" ref="partner_jane_smith"/>
        <field name="property_id" ref="property_1"/>
        <field name="validity">10</field>
    </record>

    <record id="estate_offer_3" model="estate.offer">
        <field name="price">580000</field>
        <field name="partner_id" ref="partner_bob_wilson"/>
        <field name="property_id" ref="property_2"/>
        <field name="validity">14</field>
    </record>

    <record id="estate_offer_4" model="estate.offer">
        <field name="price">370000</field>
        <field name="partner_id" ref="partner_john_doe"/>
        <field name="property_id" ref="property_3"/>
        <field name="validity">21</field>
        <field name="status">accepted</field>
    </record>

    <record id="estate_offer_5" model="estate.offer">
        <field name="price">800000</field>
        <field name="partner_id" ref="partner_jane_smith"/>
        <field name="property_id" ref="property_3"/>
        <field name="validity">30</field>
    </record>
        
    </data>
</odoo>
